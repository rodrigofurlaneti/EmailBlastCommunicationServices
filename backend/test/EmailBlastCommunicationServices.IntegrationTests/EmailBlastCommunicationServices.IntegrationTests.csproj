    <ProjectReference Include="../../src/EmailBlastCommunicationServices/EmailBlastCommunicationServices.csproj" />
    <None Include="../../../sql/*.sql" Link="sql/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
