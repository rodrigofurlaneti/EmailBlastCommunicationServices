[Unit]
Description=EmailBlast Communication Services API
After=network-online.target
Wants=network-online.target
ConditionPathExists=/opt/emailblast-api/current/EmailBlastCommunicationServices.Api.dll

[Service]
Type=simple
User=emailblast
Group=emailblast
WorkingDirectory=/opt/emailblast-api/current
ExecStart=/usr/bin/dotnet /opt/emailblast-api/current/EmailBlastCommunicationServices.Api.dll --urls=http://127.0.0.1:5201
EnvironmentFile=/etc/emailblast/api.env
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://127.0.0.1:5201
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
